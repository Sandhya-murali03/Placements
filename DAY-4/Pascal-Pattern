import java.io.*;
import java.util.*;

public class Solution {

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt(); // Total rows
        int temp=0;
        for (int i = 1; i <= n; i++) { 
            for (int j = 1; j <= 2*n-1; j++) {
                // If we haven't reached the star zone yet, print a space
                if (j <= n - i || j>n+i-1) {
                    System.out.print(" ");
                } 
                // Otherwise, print a star
                else if(j==n+i-1 || j==n-i+1)
                    System.out.print("1");
                else {
                    System.out.print((char)('A'+temp));
                    temp++;
                }
            }
            temp=0;
            // Move to the next line
            System.out.println();
        }
    }
}
