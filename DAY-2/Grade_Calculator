import java.io.*;
import java.util.*;
import java.text.*;
import java.math.*;
import java.util.regex.*;

public class Solution {

    public static void main(String[] args) {
        Scanner sc=new Scanner(System.in);
        String name=sc.next();
        int m1=sc.nextInt();
        int m2=sc.nextInt();
        int m3=sc.nextInt();
        int m4=sc.nextInt();
        int m5=sc.nextInt();
        int total=m1+m2+m3+m4+m5;
        float avg=(float)total/5;
        System.out.println("Name of the Student:"+name);
        System.out.println("Total Mark:"+total);
        System.out.printf("Average Mark:%.1f\n",(Math.floor(avg*10)/10));
        
        if(avg==100)
            System.out.println("Grade Mark:S");
        else if(avg>90)
            System.out.println("Grade Mark:A");
        else if(avg>80 && avg<89)
            System.out.println("Grade Mark:B");
        else if(avg>70 && avg<79)
            System.out.println("Grade Mark:C");
        else if(avg>60 && avg<69)
            System.out.println("Grade Mark:D");
        else if(avg>50 && avg<59)
            System.out.println("Grade Mark:E");
        else
            System.out.print("Grade Mark:Fail");
        
        /* Enter your code here. Read input from STDIN. Print output to STDOUT. Your class should be named Solution. */
    }
}
