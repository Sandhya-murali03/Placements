import java.io.*;
import java.util.*;

public class Solution {

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int n = sc.nextInt();

        if (n > 20 || n <= 0) {
            System.out.println("Invalid Input");
        } else {

            int sum = 0;

            for (int i = 1; i <= n; i++) {
                int x=n*i;
                sum+=x;
            }

            System.out.println(sum);
        }

        sc.close();
    }
}
